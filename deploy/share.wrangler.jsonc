{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "codiscuss-share",
  "main": "../backend/share_worker.mjs",
  "compatibility_date": "2026-10-14",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../web",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/*", "!/i18n.js", "!/markdown.js", "!/backup.js", "!/app.js", "!/modern.js",
      "!/modern.css", "!/markdown.css", "!/icons/*", "!/katex/*"]
  },
  "triggers": { "crons": ["0 * * * *"] },
  // Set DB.database_id and the custom domain in deploy/wrangler.local.jsonc.
  "d1_databases": [{ "binding": "DB", "database_name": "codiscuss-share" }]
}
